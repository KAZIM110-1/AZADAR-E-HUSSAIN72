  <!-- ==================== HERO SECTION END ==================== -->

  <!-- ==================== 2. SPOTLIGHT REEL SECTION START ==================== -->
  <section id="featured-reel" class="py-16 px-4 sm:px-6 lg:px-8 border-b border-zinc-800 bg-zinc-950">
    <div class="max-w-4xl mx-auto">
      
      <!-- Section Header -->
