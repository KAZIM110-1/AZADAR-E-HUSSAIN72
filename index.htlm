      <!-- Bottom Bar: Copyright & Details -->
      <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 gap-4">
        <p>© 2026 AZADAR-E-HUSSAIN_72. All rights reserved.</p>
        <div class="flex items-center gap-4">
          <span>Est. 2021</span>
          <span>•</span>
          <span>Azadari Hyderabad Digital Archive</span>
        </div>
