              <!-- Replace src with your specific reel embed URL -->
              <iframe 
                src="https://www.instagram.com/reel/C8_example/embed" 
                class="w-full h-full border-0" 
                scrolling="no" 
                allowtransparency="true"
                allow="encrypted-media">
              </iframe>

            </div>
          </div>

          <!-- Column 2: Details & Stats -->
          <div class="lg:col-span-6 space-y-6 text-left">
            
            <!-- Category Tag -->
            <span class="inline-block text-xs font-medium text-zinc-400 bg-zinc-800/80 px-3 py-1 rounded-md border border-zinc-700/50">
              Featured Edit • Hyderabad Azadari
            </span>

            <!-- Title -->
