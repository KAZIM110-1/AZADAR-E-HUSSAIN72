              <i class="fa-brands fa-instagram text-red-500 text-sm"></i>
              <span>Send DM</span>
            </a>

            <!-- WhatsApp Contact Button -->
            <a href="https://wa.me/?text=Salam,%20I%20have%20an%20inquiry%20regarding%20AZADAR-E-HUSSAIN_72" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center justify-center gap-2 bg-emerald-950/40 hover:bg-emerald-900/60 text-emerald-300 text-xs font-semibold py-2.5 px-3 rounded-xl border border-emerald-800/50 transition-all duration-200">
              <i class="fa-brands fa-whatsapp text-emerald-400 text-sm"></i>
