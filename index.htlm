            </span>
          </div>

          <!-- Admin Names List -->
          <div class="bg-zinc-950/70 border border-zinc-800/80 rounded-xl p-3.5 mb-4 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="text-zinc-400">Admin:</span>
              <span class="font-semibold text-zinc-100">Mohammed Kazim Ali</span>
            </div>
            <div class="border-t border-zinc-800/60 pt-2 flex items-center justify-between text-xs">
              <span class="text-zinc-400">Admin:</span>
              <span class="font-semibold text-zinc-100">Mohammed Hashim Ali</span>
            </div>
          </div>

          <p class="text-xs text-zinc-400 mb-5 leading-normal">
            For event media coverage, Nohay submissions, or inquiries regarding local Majalis updates, contact the admin team directly.
          </p>

          <!-- Contact Action Buttons -->
          <div class="grid grid-cols-2 gap-3">
            
            <!-- Instagram DM Button -->
            <a href="https://www.instagram.com/azadarehussain7214" target="_blank" rel="noopener noreferrer"
