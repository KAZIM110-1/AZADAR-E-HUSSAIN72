                <span class="text-xl font-black text-red-500">1M+ Views</span>
              </div>
              <div class="bg-zinc-950/60 p-3 rounded-xl border border-zinc-800/80">
                <span class="block text-xs text-zinc-400">Page</span>
                <span class="text-sm font-bold text-zinc-200 mt-1 block">@azadarehussain7214</span>
              </div>
            </div>

            <!-- Description -->
            <p class="text-zinc-400 text-sm leading-relaxed">
              Experience the powerful atmosphere captured during Muharram in Hyderabad. Watch, like, and share directly on Instagram to support our channel.
            </p>

            <!-- Watch Action Button -->
            <a href="https://www.instagram.com/azadarehussain7214" target="_blank" rel="noopener noreferrer" 
               class="inline-flex items-center justify-center gap-2.5 bg-red-600 hover:bg-red-500 text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200 w-full sm:w-auto shadow-lg shadow-red-950/40">
              <i class="fa-brands fa-instagram text-lg"></i>
              <span>Watch Reel on Instagram</span>
            </a>

          </div>

        </div>

      </div>

    </div>
  </section>
  <!-- ==================== SPOTLIGHT REEL SECTION END ==================== -->

  <!-- ==================== 3. FOOTER & ADMIN CONTACT SECTION START ==================== -->
