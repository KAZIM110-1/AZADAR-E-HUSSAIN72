<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AZADAR-E-HUSSAIN_72 | Azadari Hyderabad</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-zinc-950 text-zinc-100 font-sans antialiased selection:bg-red-900 selection:text-white">

  <!-- ==================== 1. HERO SECTION START ==================== -->
  <header class="relative overflow-hidden border-b border-zinc-800 bg-gradient-to-b from-zinc-900 via-zinc-950 to-zinc-950 py-16 px-4 sm:px-6 lg:px-8">
    
    <!-- Background Red Glow Effect -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-red-950/40 blur-3xl rounded-full pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center relative z-10">
      
      <!-- Badges: Live Follower Counter & Handle -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-6">
        
        <!-- Live Follower Badge -->
        <div class="inline-flex items-center gap-2 bg-zinc-900/90 border border-zinc-800 rounded-full px-4 py-1.5 shadow-lg backdrop-blur-md">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
          </span>
          <i class="fa-brands fa-instagram text-red-500 text-sm"></i>
          <span class="text-xs font-medium text-zinc-400">Followers:</span>
          <span class="text-xs font-bold text-zinc-100 tracking-wide">50K+</span>
        </div>

        <!-- Handle Badge -->
        <div class="inline-flex items-center gap-2 bg-zinc-900/90 border border-zinc-800 rounded-full px-4 py-1.5 shadow-lg backdrop-blur-md">
          <i class="fa-solid fa-at text-red-500 text-xs"></i>
          <span class="text-xs font-semibold text-zinc-200">azadarehussain7214</span>
        </div>

      </div>

      <!-- Main Page Heading -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-wider leading-tight">
        AZADAR-E-<span class="text-red-600">HUSSAIN_72</span>
      </h1>

      <!-- Tagline -->
      <p class="mt-4 text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto font-normal">
        Documenting & Editing Majalis, Juloos, Nohay, and the Sacred Heritage of Azadari across Hyderabad.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        
        <!-- Instagram Link Button -->
        <a href="https://www.instagram.com/azadarehussain7214" target="_blank" rel="noopener noreferrer" 
           class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-red-800 to-red-600 hover:from-red-700 hover:to-red-500 text-white font-semibold text-sm px-6 py-3 rounded-xl transition-all duration-200 shadow-lg shadow-red-950/50 hover:shadow-red-900/80">
          <i class="fa-brands fa-instagram text-lg"></i>
          <span>Visit @azadarehussain7214</span>
        </a>

        <!-- Watch Edits Button -->
        <a href="#featured-reel" 
           class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white font-medium text-sm px-6 py-3 rounded-xl border border-zinc-800 transition-all duration-200">
          <i class="fa-solid fa-play text-xs text-red-500"></i>
          <span>Watch Highest Viewed Reel</span>
        </a>

      </div>

    </div>
